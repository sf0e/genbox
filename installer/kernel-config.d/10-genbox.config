# genbox kernel tuning: a practical production kernel, not a debug kernel.
# Disabling these dramatically reduces compile time and kernel/module size.
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_KERNEL=n
CONFIG_KUNIT=n
CONFIG_UBSAN=n
CONFIG_KCOV=n
CONFIG_FUNCTION_TRACER=n
CONFIG_FTRACE=n
CONFIG_DYNAMIC_FTRACE=n
CONFIG_GCOV_KERNEL=n
